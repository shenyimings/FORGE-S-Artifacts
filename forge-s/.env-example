# Copy to `.env` and fill in your own keys. Never commit `.env`.

# ---- LLM (required) ----
# Key for the OpenAI-compatible endpoint configured in config.yaml (`llm.base_url`).
# Default endpoint is OpenRouter: https://openrouter.ai/keys
API_KEY=sk-or-xxxx

# ---- Source-code fetcher (optional) ----
# GitHub personal access token; raises the API rate limit when fetching audited repositories.
GITHUB_TOKEN=ghp_xxxx

# Etherscan API V2 key (one key covers Ethereum, BSC, Polygon, Arbitrum and Base).
# Only needed for reports that reference EVM contract addresses.
ETH_API_KEY=xxxx
