# Copy to `.env` and fill in your own keys. Never commit `.env`.
#
# Each component reads its own `.env`; see the component-specific templates:
#   forge-s/.env-example                    FORGE-S pipeline (LLM + source-code fetcher)
#   evaluation/rq3/evaluator/.env-example   RQ3 LLM detection evaluation
#
# A `.env` at the repository root is also picked up by the RQ3 evaluator
# when `evaluation/rq3/evaluator/.env` does not exist.

# OpenRouter API key (https://openrouter.ai/keys)
API_KEY=sk-or-xxxx

# Optional: another OpenAI-compatible endpoint instead of OpenRouter
# BASE_URL=https://openrouter.ai/api/v1
